rules_version = '2';
// Security rules for Practice with Ehsan.
// Paste into: Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // A teacher is a signed-in user whose ID is listed in the "teachers" collection
    // (added by hand in the Firebase console).
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // One document per student: profile, Dictation words and daily scores, Pronunciation data (pron), Shadowing data (shad),
    // and the same three for Spanish inside "es" (es.dict, es.pron, es.shad).
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isTeacher());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'lastActive', 'words', 'days', 'pron', 'shad', 'es']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Teachers list: readable by the teacher themself, never writable from the website.
    match /teachers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
